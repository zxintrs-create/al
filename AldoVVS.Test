-- Helper: Baris Input (TextBox + Button)
local function createInputRow(labelText, defaultVal, btnText, callback)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, -12, 0, 34)
    container.BackgroundTransparency = 1
    container.Parent = MainScroll

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0, 120, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = Color3.fromRGB(230, 230, 230)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 12
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextStrokeTransparency = 1
    label.Parent = container

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0, 110, 1, 0)
    box.Position = UDim2.new(0, 125, 0, 0)
    box.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    box.Text = tostring(defaultVal)
    box.TextColor3 = Color3.fromRGB(0, 255, 255)
    box.Font = Enum.Font.Gotham
    box.TextSize = 12
    box.ClearTextOnFocus = false
    box.Parent = container

    local boxCorner = Instance.new("UICorner")
    boxCorner.CornerRadius = UDim.new(0, 6)
    boxCorner.Parent = box
    applyBorderOnlyGradient(box, 1)

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -245, 1, 0)
    btn.Position = UDim2.new(0, 245, 0, 0)
    btn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    btn.Text = btnText
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.TextStrokeTransparency = 1
    btn.Active = true
    btn.Parent = container

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = btn
    applyBorderOnlyGradient(btn, 1)

    btn.Activated:Connect(function()
        callback(box.Text)
    end)

    return container
end

-- Helper: Tombol Toggle (ON/OFF)
local function createToggleRow(labelText, defaultState, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -12, 0, 34)
    btn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.TextStrokeTransparency = 1
    btn.Active = true
    btn.Parent = MainScroll

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = btn
    applyBorderOnlyGradient(btn, 1)

    local state = defaultState
    local function updateText()
        if state then
            btn.Text = "   " .. labelText .. "  [ ON ]"
            btn.TextColor3 = Color3.fromRGB(0, 255, 150)
        else
            btn.Text = "   " .. labelText .. "  [ OFF ]"
            btn.TextColor3 = Color3.fromRGB(220, 220, 220)
        end
    end
    updateText()

    btn.Activated:Connect(function()
        state = not state
        updateText()
        callback(state)
    end)

    return btn
end

-- Helper: Tombol Aksi Biasa
local function createActionButton(labelText, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -12, 0, 34)
    btn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    btn.Text = "   " .. labelText
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.TextStrokeTransparency = 1
    btn.Active = true
    btn.Parent = MainScroll

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = btn
    applyBorderOnlyGradient(btn, 1)

    btn.Activated:Connect(callback)
    return btn
end

---------------------------------------------------------
-- FITUR ELEMEN DI HALAMAN MAIN
---------------------------------------------------------

-- Auto Walk Toggle
local WalkToggle = createToggleRow("🚶 Auto Walk", false, function(state)
    setWalkEnabled(state)
end)

-- WalkSpeed
createInputRow("⚡ WalkSpeed", 16, "Set Speed", function(val)
    local num = tonumber(val)
    if num and LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        LocalPlayer.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = num
    end
end)

-- JumpPower
createInputRow("🦘 JumpPower", 50, "Set Jump", function(val)
    local num = tonumber(val)
    if num and LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        hum.UseJumpPower = true
        hum.JumpPower = num
    end
end)

-- Fly Speed
createInputRow("✈️ Fly Speed", 50, "Set FlySpeed", function(val)
    local num = tonumber(val)
    if num then flySpeed = num end
end)

-- Fly Toggle
createToggleRow("🕊️ Fly (Mobile/PC)", false, function(state)
    toggleFly(state)
end)

-- Noclip Toggle
createToggleRow("👻 Noclip", false, function(state)
    toggleNoclip(state)
end)

-- Infinite Jump Toggle
createToggleRow("🥷 Infinite Jump", false, function(state)
    isInfJump = state
end)

-- Teleport Target
createInputRow("🌀 Teleport", "Nama User", "Teleport", function(val)
    teleportToPlayer(val)
end)

-- View / Spectate Player
createInputRow("👁️ View Player", "Nama User", "Spectate", function(val)
    spectatePlayer(val)
end)

-- Reset Camera
createActionButton("📹 Reset Camera View", function()
    spectatePlayer("")
end)

-- Reset Character
createActionButton("🔄 Reset Character", function()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        LocalPlayer.Character:FindFirstChildOfClass("Humanoid").Health = 0
    end
end)

-- Rejoin Server
createActionButton("🌐 Rejoin Server", function()
    TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
end)

---------------------------------------------------------
-- PERPINDAHAN TAB
---------------------------------------------------------
local function switchTab(tabName)
    if tabName == "Emote" then
        EmotePage.Visible = true
        MainPage.Visible = false
        TeleportPage.Visible = false
        TabEmoteBtn.TextColor3 = Color3.fromRGB(0, 255, 255)
        TabEmoteBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        TabMainBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
        TabMainBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
        TabTeleportBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
        TabTeleportBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    elseif tabName == "Main" then
        EmotePage.Visible = false
        MainPage.Visible = true
        TeleportPage.Visible = false
        TabEmoteBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
        TabEmoteBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
        TabMainBtn.TextColor3 = Color3.fromRGB(0, 255, 255)
        TabMainBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        TabTeleportBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
        TabTeleportBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    elseif tabName == "Teleport" then
        EmotePage.Visible = false
        MainPage.Visible = false
        TeleportPage.Visible = true
        TabEmoteBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
        TabEmoteBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
        TabMainBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
        TabMainBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
        TabTeleportBtn.TextColor3 = Color3.fromRGB(0, 255, 255)
        TabTeleportBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    end
end


TabEmoteBtn.Activated:Connect(function() switchTab("Emote") end)
TabMainBtn.Activated:Connect(function() switchTab("Main") end)
TabTeleportBtn.Activated:Connect(function() switchTab("Teleport") end)

