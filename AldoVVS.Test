local teleportScriptEnabled = false

local function setTeleportScriptEnabled(state)
    teleportScriptEnabled = state

    if state then
        TeleportToggle.Text = "   TELEPORT SCRIPT  [ ON ]"
        TeleportToggle.TextColor3 = Color3.fromRGB(0, 255, 150)
        TeleportToggle.BackgroundColor3 = Color3.fromRGB(25, 45, 35)

        if guiElements and guiElements.ScreenGui and guiElements.ScreenGui.Parent then
            guiElements.ScreenGui.Enabled = true
            guiElements.MainFrame.Visible = false
        end
    else
        TeleportToggle.Text = "   TELEPORT SCRIPT  [ OFF ]"
        TeleportToggle.TextColor3 = Color3.fromRGB(220, 220, 220)
        TeleportToggle.BackgroundColor3 = Color3.fromRGB(20, 20, 20)

        if autoTeleport then
            stopAutoTeleport()
        else
            clearPlatform()
        end
        loopEnabled = false

        if guiElements and guiElements.ScreenGui and guiElements.ScreenGui.Parent then
            guiElements.MainFrame.Visible = false
            guiElements.ScreenGui.Enabled = false
        end
    end
end

TeleportToggle.Activated:Connect(function()
    setTeleportScriptEnabled(not teleportScriptEnabled)
end)

